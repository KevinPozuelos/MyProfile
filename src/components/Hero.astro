---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import { profile } from '@/data/profile';
import { withBase } from '@/lib/utils';

const github = profile.socials.find((s) => s.label === 'GitHub');
const linkedin = profile.socials.find((s) => s.label === 'LinkedIn');
---

<section id="inicio" class="relative overflow-hidden pt-28 pb-20 sm:pt-36 sm:pb-28">
  <div class="bg-grid pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>

  <div class="container-page grid items-center gap-12 md:grid-cols-[1fr_auto]">
    <div class="reveal order-2 md:order-1">
      <p
        class="inline-flex items-center gap-2 rounded-full border border-border bg-surface px-3 py-1 font-mono text-xs text-muted"
      >
        <span class="size-2 rounded-full bg-emerald-500" aria-hidden="true"></span>
        {profile.location}
      </p>

      <h1 class="mt-5 text-4xl font-extrabold tracking-tight text-heading sm:text-5xl lg:text-6xl">
        {profile.name}
      </h1>
      <p class="mt-3 text-xl font-semibold text-accent sm:text-2xl">{profile.role}</p>
      <p class="mt-5 max-w-xl text-lg leading-relaxed text-muted">{profile.tagline}</p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a href={withBase(profile.cv.href)} download={profile.cv.fileName} class="btn-primary">
          <Icon name="lucide:download" class="size-4" />
          Descargar CV
        </a>
        {
          github && (
            <a href={github.href} class="btn-secondary" target="_blank" rel="noopener noreferrer">
              <Icon name={github.icon} class="size-4" />
              GitHub
              <span class="sr-only">(abre en una pestaña nueva)</span>
            </a>
          )
        }
        {
          linkedin && (
            <a href={linkedin.href} class="btn-secondary" target="_blank" rel="noopener noreferrer">
              <Icon name={linkedin.icon} class="size-4" />
              LinkedIn
              <span class="sr-only">(abre en una pestaña nueva)</span>
            </a>
          )
        }
        <a href="#contacto" class="btn-secondary">
          <Icon name="lucide:send" class="size-4" />
          Contacto
        </a>
      </div>
    </div>

    <div class="reveal order-1 justify-self-center md:order-2">
      <div class="relative">
        <div
          class="absolute -inset-3 rounded-full bg-gradient-to-br from-accent/40 to-navy/40 blur-2xl"
          aria-hidden="true"
        >
        </div>
        <Picture
          src={profile.photo.src}
          alt={profile.photo.alt}
          formats={['avif', 'webp']}
          widths={[192, 288, 384, 576]}
          sizes="(min-width: 1024px) 288px, (min-width: 640px) 240px, 192px"
          loading="eager"
          fetchpriority="high"
          class="relative size-48 rounded-full border-4 border-surface object-cover shadow-xl ring-2 ring-accent sm:size-60 lg:size-72"
        />
      </div>
    </div>
  </div>
</section>
