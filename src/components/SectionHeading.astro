---
interface Props {
  /** id del <h2>, usado por `aria-labelledby` en la sección. */
  id: string;
  eyebrow: string;
  title: string;
  description?: string;
}

const { id, eyebrow, title, description } = Astro.props;
---

<header class="reveal mb-10 max-w-2xl">
  <p class="font-mono text-sm text-accent">// {eyebrow}</p>
  <h2 id={id} class="mt-2 text-3xl font-bold tracking-tight text-heading sm:text-4xl">{title}</h2>
  {description && <p class="mt-3 text-muted">{description}</p>}
</header>
