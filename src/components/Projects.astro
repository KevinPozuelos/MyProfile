---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import TagList from './TagList.astro';
import { projects } from '@/data/projects';
---

<section id="proyectos" class="py-20 sm:py-24" aria-labelledby="proyectos-title">
  <div class="container-page">
    <SectionHeading
      id="proyectos-title"
      eyebrow="proyectos"
      title="Proyectos destacados"
      description="Una selección de repositorios públicos enfocados en backend, microservicios y CI/CD."
    />

    <ul class="grid gap-6 md:grid-cols-2">
      {
        projects.map((project) => (
          <li class="reveal">
            <article class="group flex h-full flex-col rounded-xl border border-border bg-surface p-6 transition-all duration-200 hover:-translate-y-0.5 hover:border-accent/60 hover:shadow-lg">
              <div class="flex items-start justify-between gap-4">
                <span class="grid size-10 place-items-center rounded-lg bg-surface-muted text-accent" aria-hidden="true">
                  <Icon name="lucide:folder-git-2" class="size-5" />
                </span>
                <span class="font-mono text-xs text-muted">{project.focus}</span>
              </div>

              <h3 class="mt-4 text-lg font-semibold text-heading">{project.name}</h3>
              <p class="mt-2 flex-1 text-muted">{project.description}</p>

              <div class="mt-5">
                <TagList tags={project.tags} label={`Tecnologías de ${project.name}`} />
              </div>

              <div class="mt-5 flex flex-wrap gap-4 border-t border-border pt-4 text-sm font-medium">
                <a
                  href={project.repo}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 text-accent hover:underline"
                >
                  <Icon name="simple-icons:github" class="size-4" />
                  Repositorio
                  <span class="sr-only">de {project.name} (abre en una pestaña nueva)</span>
                </a>
                {project.demo && (
                  <a
                    href={project.demo}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1.5 text-accent hover:underline"
                  >
                    <Icon name="lucide:external-link" class="size-4" />
                    Demo
                    <span class="sr-only">de {project.name} (abre en una pestaña nueva)</span>
                  </a>
                )}
              </div>
            </article>
          </li>
        ))
      }
    </ul>

    <p class="reveal mt-10 text-center">
      <a
        href="https://github.com/KevinPozuelos?tab=repositories"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 font-medium text-accent hover:underline"
      >
        Ver todos mis repositorios
        <Icon name="lucide:arrow-up-right" class="size-4" />
        <span class="sr-only">(abre en una pestaña nueva)</span>
      </a>
    </p>
  </div>
</section>
