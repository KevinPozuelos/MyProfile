---
/**
 * Renderiza un ícono de Iconify como SVG inline en build time (cero JS en el cliente).
 * Uso: <Icon name="simple-icons:docker" class="size-5" />
 */
import { getIconData, iconToHTML, iconToSVG, replaceIDs } from '@iconify/utils';
import { icons as lucide } from '@iconify-json/lucide';
import { icons as simpleIcons } from '@iconify-json/simple-icons';
import type { IconName } from '@/types';

interface Props {
  name: IconName;
  class?: string;
  /** Si se pasa, el ícono deja de ser decorativo y se anuncia a lectores de pantalla. */
  label?: string;
}

const { name, class: className = 'size-5', label } = Astro.props;
const [prefix, iconName] = name.split(':') as [string, string];
const collection = prefix === 'lucide' ? lucide : simpleIcons;
const data = getIconData(collection, iconName);

if (!data) {
  throw new Error(`Ícono no encontrado: ${name}`);
}

const { attributes, body } = iconToSVG(data, { height: 'auto' });
const a11y: Record<string, string> = label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true' };
const svg = iconToHTML(replaceIDs(body), {
  ...attributes,
  ...a11y,
  class: className,
  focusable: 'false',
});
---

<Fragment set:html={svg} />
